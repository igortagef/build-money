# Connection string do Postgres (Neon).
# Crie um projeto gratuito em https://neon.tech e cole a string abaixo.
# Formato: postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Segredo da sessão. Gere com: npx auth secret
AUTH_SECRET=

# URL pública do app (usada nos links de e-mail). Ex.: https://app.seu-dominio.com
APP_URL=

# E-mail (Resend). Sem estas, os e-mails caem no log do servidor.
# Crie a conta em https://resend.com, verifique um domínio e cole a chave.
RESEND_API_KEY=
EMAIL_FROM="Build Money <nao-responda@seu-dominio.com>"
